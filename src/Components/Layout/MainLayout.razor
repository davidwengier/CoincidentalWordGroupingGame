@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="page">
    <header class="top-row">
        <div class="top-row-items">
            <span class="build-indicator" title="@BuildDetails.CommitHash">Build @BuildDetails.ShortCommitHash</span>

            <button
                type="button"
                class="theme-toggle"
                aria-label="Dark mode"
                aria-pressed="@_isDarkMode"
                disabled="@(_themeModule is null)"
                @onclick="ToggleThemeAsync">
                <span class="theme-toggle-icon" aria-hidden="true">@(_isDarkMode ? "🌙" : "☀️")</span>
                <span>Dark mode</span>
                <span class="theme-toggle-state">@(_isDarkMode ? "On" : "Off")</span>
            </button>
        </div>
    </header>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code
{
    private IJSObjectReference? _themeModule;
    private bool _isDarkMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _themeModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/theme.js");
        _isDarkMode = await _themeModule.InvokeAsync<bool>("initializeTheme");
        StateHasChanged();
    }

    private async Task ToggleThemeAsync()
    {
        if (_themeModule is null)
        {
            return;
        }

        _isDarkMode = await _themeModule.InvokeAsync<bool>("toggleTheme");
    }

    public async ValueTask DisposeAsync()
    {
        if (_themeModule is null)
        {
            return;
        }

        try
        {
            await _themeModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
